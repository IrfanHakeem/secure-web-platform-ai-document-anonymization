# ────────────────────────────────────────────────────────────
# Secura Backend — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ────────────────────────────────────────────────────────────

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fyp_anonymization
DB_USER=postgres
DB_PASSWORD=change_me

# JWT — generate a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Fernet encryption key for documents at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_me

# Max upload size in MB
MAX_FILE_SIZE_MB=100

# SMTP (Brevo example)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM_EMAIL=change_me@example.com

# OTP / password recovery
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# Network sensor integration
NETWORK_SENSOR_API_KEY=change_me
