
{
    auto_https disable_redirects
}

https://10.10.20.10, https://secura.local {

    tls C:/FYP/certs/secura-lan.pem C:/FYP/certs/secura-lan-key.pem

    encode zstd gzip

    # Forward API requests to FastAPI using HTTP
    handle_path /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    # Serve Secura React frontend
    handle {
        root * C:/FYP/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
